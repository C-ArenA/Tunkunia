@article{lozanotelloFactoresDecisionPara,
  title = {Factores de Decisión Para La Reutilización de Componentes Software},
  author = {Lozano Tello, Adolfo and Gómez Pérez, Asunción},
  abstract = {En la fase de planificación de un proyecto software, el ingeniero se  enfrenta al dilema de reutilizar un componente software frente a  varios que cumplen unos requisitos apropiados. Para decidir cuál es  el más adecuado, lo primero que debe hacer es fijar unas  prioridades en sus requisitos. Si el componente debe sufrir un  proceso de adaptación para integrarlo al proyecto, se debe evaluar  si conviene hacerlo por el propio equipo de desarrollo o encargarlo  a una empresa externa. El artículo ofrece una guía para ayudar a la  toma de estas decisiones, describiendo las características relevantes  de los componentes software, que van a influir en cada uno de estos  aspectos de decisión.}
}


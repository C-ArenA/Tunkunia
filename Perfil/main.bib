@article{simonStateMachinesPetri,
  title = {State Machines and Petri Nets as a Formal Representation for Systems Life Cycle Management},
  author = {Simon, Eric and Stoffel, Kilian},
  url = {https://www.researchgate.net/publication/228721890_State_machines_and_petri_nets_as_a_formal_representation_for_systems_life_cycle_management},
  urldate = {2024-07-01},
  abstract = {In systems life cycle management (SLCM), there is a gap between the rather informal methodologies for systems development and the sound mathematical formalisms needed for the automatic validation of systems properties and correctness proofs. This paper presents a model based on finite state machines and its translation into Petri nets, a mathematical representation with the desired degree of provability in this context. We argue that the model can bridge that gap, by allowing inexperienced non specialists to represent their development methodologies and all their key features using simple automata and applying a systems thinking approach to problem solving, instead of having to express the model in a more complicated representation from the start.}
}


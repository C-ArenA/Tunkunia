@article{donorfioPoliticsFreeOpen2004,
  title = {The Politics of "Free": Open Source Software in Government},
  shorttitle = {The Politics of "Free"},
  author = {Donorfio, Brian},
  date = {2004-01-01},
  journaltitle = {Journal of Computing Sciences in Colleges - JCSC},
  shortjournal = {Journal of Computing Sciences in Colleges - JCSC},
  abstract = {"Linux has become a Wall Street buzzword, much like 'e-commerce' and 'dot-com' before it" according to Sam Williams in Free as in Freedom . Even after the dot-com bust, however, the adoption of open source alternatives, such as the GNU/Linux operating system, is still a hot topic in both the public and private sectors. With large companies such as Sun Microsystems and IBM now giving their full support to open source initiatives and the growing consumer backlash against the Microsoft Windows operating system, the so-called open source movement is beginning to gain popular exposure, both in the private sector, as well as in government applications. Governmental use of free software --- not just free in the commercial sense, but "free as in speech" --- can have a democratizing effect on the government.}
}

